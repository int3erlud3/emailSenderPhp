{
    "name": "int3erlud3/email-sender-php",
    "description": "Secure SMTP mailer (PHPMailer, TLS) with a hardened contact form and CLI",
    "type": "project",
    "license": "MIT",
    "authors": [{"name": "Alii"}],
    "require": {
        "php": ">=8.3",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {"EmailSender\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"EmailSender\\Tests\\": "tests/"}
    },
    "bin": ["bin/send-mail"],
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --no-progress --memory-limit=1G",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "check": ["@cs", "@stan", "@test"]
    },
    "config": {
        "platform": {"php": "8.3.0"},
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {},
        "audit": {"abandoned": "fail"}
    },
    "minimum-stability": "stable"
}
