# Copy to .env (never commit it) or export the variables in your shell / service manager.
# Every value is intentionally empty. Empty optional values fall back to safe defaults.

# SMTP server (required)
SMTP_HOST=
# 587 for starttls (default), 465 for smtps
SMTP_PORT=
# starttls (default) | smtps | none (none only together with SMTP_ALLOW_INSECURE=1, for a local test server)
SMTP_ENCRYPTION=
SMTP_ALLOW_INSECURE=
SMTP_USERNAME=
# Prefer SMTP_PASSWORD_FILE (path to a file with mode 0600) over SMTP_PASSWORD
SMTP_PASSWORD_FILE=
SMTP_PASSWORD=
# Optional CA bundle for a private CA (verification is always on)
SMTP_CA_FILE=
SMTP_TIMEOUT=

# Envelope (MAIL_FROM is required; MAIL_TO is required for the contact form)
MAIL_FROM=
MAIL_FROM_NAME=
MAIL_TO=

# Contact form rate limit: max submissions per client IP per window (seconds)
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW=
RATE_LIMIT_DIR=
